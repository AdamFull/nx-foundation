<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

    <Type Name="nx::fixed_vector&lt;*,*&gt;">
        <DisplayString>{{ size={m_size} }}</DisplayString>
        <Expand>
            <ArrayItems>
                <Size>m_size</Size>
                <ValuePointer>($T1*)m_storage</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <Type Name="nx::small_vector&lt;*,*,*&gt;">
        <DisplayString>{{ size={m_size} }}</DisplayString>
        <Expand>
            <ArrayItems>
                <Size>m_size</Size>
                <ValuePointer>m_data</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <Type Name="nx::mpmc::Queue&lt;*,*&gt;">
        <DisplayString>{{ size~{m_enqueue_pos._Storage._Value - m_dequeue_pos._Storage._Value}, capacity={CAPACITY} }}
        </DisplayString>
        <Expand>
            <Item Name="[capacity]">CAPACITY</Item>
            <CustomListItems MaxItemsPerView="5000">
                <Variable Name="dq" InitialValue="m_dequeue_pos._Storage._Value"/>
                <Variable Name="eq" InitialValue="m_enqueue_pos._Storage._Value"/>
                <Variable Name="i" InitialValue="dq"/>
                <Loop Condition="i != eq">
                    <Item Name="[{i - dq}]">*($T1*)(m_slots[i &amp; MASK].storage)</Item>
                    <Exec>++i</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <Type Name="nx::mpsc::Queue&lt;*,*&gt;">
        <DisplayString>{{ size~{m_enqueue_pos._Storage._Value - m_dequeue_pos._Storage._Value}, capacity={CAPACITY} }}
        </DisplayString>
        <Expand>
            <Item Name="[capacity]">CAPACITY</Item>
            <CustomListItems MaxItemsPerView="5000">
                <Variable Name="dq" InitialValue="m_dequeue_pos._Storage._Value"/>
                <Variable Name="eq" InitialValue="m_enqueue_pos._Storage._Value"/>
                <Variable Name="i" InitialValue="dq"/>
                <Loop Condition="i != eq">
                    <Item Name="[{i - dq}]">*($T1*)(m_slots[i &amp; MASK].storage)</Item>
                    <Exec>++i</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>


    <Type Name="nx::Guid">
        <Intrinsic Name="hex" Expression="&quot;0123456789abcdef&quot; + n">
            <Parameter Name="n" Type="unsigned int"/>
        </Intrinsic>
        <DisplayString>
            {bytes._Elems[0],nvoxb}{bytes._Elems[1],nvoxb}{bytes._Elems[2],nvoxb}{bytes._Elems[3],nvoxb}-{bytes._Elems[4],nvoxb}{bytes._Elems[5],nvoxb}-{bytes._Elems[6],nvoxb}{bytes._Elems[7],nvoxb}-{bytes._Elems[8],nvoxb}{bytes._Elems[9],nvoxb}-{bytes._Elems[10],nvoxb}{bytes._Elems[11],nvoxb}{bytes._Elems[12],nvoxb}{bytes._Elems[13],nvoxb}{bytes._Elems[14],nvoxb}{bytes._Elems[15],nvoxb}
        </DisplayString>
        <Expand>
            <ArrayItems>
                <Size>16</Size>
                <ValuePointer>bytes._Elems</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <Type Name="nx::basic_string&lt;*&gt;">
        <Intrinsic Name="is_heap" Expression="(m_sso.size &amp; 0x80) != 0"/>
        <Intrinsic Name="sso_size" Expression="(unsigned char)m_sso.size"/>
        <DisplayString Condition="is_heap()">{m_heap.data,s8}</DisplayString>
        <DisplayString>{&amp;m_sso.data[0],s8}</DisplayString>
        <StringView Condition="is_heap()">m_heap.data,s8</StringView>
        <StringView>&amp;m_sso.data[0],s8</StringView>
        <Expand>
            <Item Name="[size]" Condition="is_heap()">m_heap.size</Item>
            <Item Name="[size]" Condition="!is_heap()">sso_size()</Item>
            <Item Name="[capacity]" Condition="is_heap()">m_heap.capacity &amp; ~HEAP_MASK</Item>
            <Item Name="[capacity]" Condition="!is_heap()">SSO_CAPACITY</Item>
            <Item Name="[allocator]">m_alloc</Item>
            <ArrayItems Condition="is_heap()">
                <Size>m_heap.size</Size>
                <ValuePointer>m_heap.data</ValuePointer>
            </ArrayItems>
            <ArrayItems Condition="!is_heap()">
                <Size>sso_size()</Size>
                <ValuePointer>&amp;m_sso.data[0]</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <Type Name="nx::basic_handle&lt;*,*,*&gt;">
        <DisplayString Condition="(m_value &amp; index_mask) == null_index">null</DisplayString>
        <DisplayString>{{ index={m_value &amp; index_mask}, version={m_value &gt;&gt; index_bits} }}</DisplayString>
        <Expand>
            <Item Name="[index]">m_value &amp; index_mask</Item>
            <Item Name="[version]">m_value &gt;&gt; index_bits</Item>
            <Item Name="[raw]">m_value</Item>
        </Expand>
    </Type>

    <Type Name="nx::stable_pool&lt;*,*,*&gt;">
        <DisplayString>{{ size={m_size}, capacity={m_capacity} }}</DisplayString>
        <Expand>
            <Item Name="[size]">m_size</Item>
            <Item Name="[capacity]">m_capacity</Item>
            <CustomListItems MaxItemsPerView="5000">
                <Variable Name="i" InitialValue="0"/>
                <Variable Name="ps" InitialValue="nx::stable_pool&lt;$T1,$T2,$T3&gt;::page_size"/>
                <Loop Condition="i &lt; m_capacity">
                    <If Condition="m_pages._Mypair._Myval2._Myfirst[i / ps][i % ps].st == nx::stable_pool&lt;$T1,$T2,$T3&gt;::state::occupied">
                        <Item Name="[{i}]">*($T1*)(m_pages._Mypair._Myval2._Myfirst[i / ps][i % ps].storage)</Item>
                    </If>
                    <Exec>++i</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <Type Name="nx::slot_map&lt;*,*,*&gt;">
        <DisplayString>{{ size={m_dense._Mypair._Myval2._Mylast - m_dense._Mypair._Myval2._Myfirst} }}</DisplayString>
        <Expand>
            <ArrayItems>
                <Size>m_dense._Mypair._Myval2._Mylast - m_dense._Mypair._Myval2._Myfirst</Size>
                <ValuePointer>m_dense._Mypair._Myval2._Myfirst</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <Type Name="nx::flat_map&lt;*,*,*,*,*,*&gt;">
        <DisplayString>{{ size={m_c.keys._Mypair._Myval2._Mylast - m_c.keys._Mypair._Myval2._Myfirst} }}</DisplayString>
        <Expand>
            <CustomListItems MaxItemsPerView="5000">
                <Variable Name="i" InitialValue="0"/>
                <Variable Name="n" InitialValue="m_c.keys._Mypair._Myval2._Mylast - m_c.keys._Mypair._Myval2._Myfirst"/>
                <Loop Condition="i &lt; n">
                    <Item Name="[{m_c.keys._Mypair._Myval2._Myfirst[i]}]">m_c.values._Mypair._Myval2._Myfirst[i]</Item>
                    <Exec>++i</Exec>
                </Loop>
            </CustomListItems>
        </Expand>
    </Type>

    <Type Name="nx::sparse_set&lt;*,*,*,*&gt;">
        <DisplayString>{{ size={m_dense._Mypair._Myval2._Mylast - m_dense._Mypair._Myval2._Myfirst} }}</DisplayString>
        <Expand>
            <Synthetic Name="[entities]">
                <Expand>
                    <ArrayItems>
                        <Size>m_dense._Mypair._Myval2._Mylast - m_dense._Mypair._Myval2._Myfirst</Size>
                        <ValuePointer>m_dense._Mypair._Myval2._Myfirst</ValuePointer>
                    </ArrayItems>
                </Expand>
            </Synthetic>
            <ArrayItems>
                <Size>m_values._Mypair._Myval2._Mylast - m_values._Mypair._Myval2._Myfirst</Size>
                <ValuePointer>m_values._Mypair._Myval2._Myfirst</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <Type Name="nx::id_string">
        <DisplayString Condition="m_id == 0">(empty)</DisplayString>
        <DisplayString>id={m_id,Xb}</DisplayString>
        <Expand>
            <Item Name="[id]">m_id</Item>
        </Expand>
    </Type>

    <Type Name="nx::shared_ptr&lt;void&gt;">
        <DisplayString Condition="m_ptr == nullptr">empty</DisplayString>
        <DisplayString>void* {m_ptr} [{((nx::detail::SharedHeader*)m_ptr - 1)->refs._Storage._Value} refs]</DisplayString>
        <Expand>
            <Item Name="[refs]" Condition="m_ptr != nullptr">((nx::detail::SharedHeader*)m_ptr - 1)->refs._Storage._Value</Item>
            <Item Name="[ptr]">m_ptr</Item>
        </Expand>
    </Type>

    <Type Name="nx::shared_ptr&lt;*&gt;">
        <DisplayString Condition="m_ptr == nullptr">empty</DisplayString>
        <DisplayString>{*m_ptr} [{((nx::detail::SharedHeader*)m_ptr - 1)->refs._Storage._Value} refs]</DisplayString>
        <Expand>
            <Item Name="[refs]" Condition="m_ptr != nullptr">((nx::detail::SharedHeader*)m_ptr - 1)->refs._Storage._Value</Item>
            <Item Name="[ptr]">m_ptr</Item>
            <ExpandedItem Condition="m_ptr != nullptr">*m_ptr</ExpandedItem>
        </Expand>
    </Type>

    <Type Name="nx::life_watch">
        <DisplayString Condition="m_flag.m_ptr == nullptr">no token</DisplayString>
        <DisplayString Condition="m_flag.m_ptr->_Storage._Value">alive</DisplayString>
        <DisplayString>dead</DisplayString>
    </Type>

    <!-- The resume address is the return slot of the context_x64_win.asm frame (0x108). -->
    <Type Name="nx::fiber::Context">
        <DisplayString Condition="m_sp == nullptr">running</DisplayString>
        <DisplayString>suspended at {(void(*)())((void**)m_sp)[33],na}</DisplayString>
        <Expand>
            <Item Name="[resume address]" Condition="m_sp != nullptr">(void(*)())((void**)m_sp)[33]</Item>
            <Item Name="[saved sp]">m_sp</Item>
            <Item Name="[stack bottom]">m_stack_bottom</Item>
            <Item Name="[stack size]">m_stack_size</Item>
            <Item Name="[entry]">m_entry</Item>
        </Expand>
    </Type>

    <Type Name="nx::fiber::Stack">
        <DisplayString>{{ [{limit}, {base}) size={(char*)base - (char*)limit} }}</DisplayString>
    </Type>

    <!-- Every backend keeps the lanes contiguous: one register, an array of registers, or a plain array. -->
    <Type Name="nx::simd::basic_vec&lt;*,*&gt;">
        <Intrinsic Name="size" Expression="(int)(sizeof(m_data) / sizeof($T1))"/>
        <Intrinsic Name="at" Expression="(($T1*)&amp;m_data)[i]">
            <Parameter Name="i" Type="int"/>
        </Intrinsic>
        <DisplayString Condition="size() == 1">{{ {at(0)} }}</DisplayString>
        <DisplayString Condition="size() == 2">{{ {at(0)}, {at(1)} }}</DisplayString>
        <DisplayString Condition="size() == 3">{{ {at(0)}, {at(1)}, {at(2)} }}</DisplayString>
        <DisplayString Condition="size() == 4">{{ {at(0)}, {at(1)}, {at(2)}, {at(3)} }}</DisplayString>
        <DisplayString>{{ size={size()} }}</DisplayString>
        <Expand>
            <ArrayItems>
                <Size>size()</Size>
                <ValuePointer>($T1*)&amp;m_data</ValuePointer>
            </ArrayItems>
        </Expand>
    </Type>

    <!-- Complex lanes are stored as a vector of real parts and a vector of imaginary parts. -->
    <Type Name="nx::simd::basic_vec&lt;std::complex&lt;*&gt;,*&gt;" Priority="High">
        <Intrinsic Name="size" Expression="(int)(sizeof(m_data.re) / sizeof($T1))"/>
        <Intrinsic Name="re" Expression="(($T1*)&amp;m_data.re)[i]">
            <Parameter Name="i" Type="int"/>
        </Intrinsic>
        <Intrinsic Name="im" Expression="(($T1*)&amp;m_data.im)[i]">
            <Parameter Name="i" Type="int"/>
        </Intrinsic>
        <DisplayString Condition="size() == 1">{{ ({re(0)}, {im(0)}) }}</DisplayString>
        <DisplayString Condition="size() == 2">{{ ({re(0)}, {im(0)}), ({re(1)}, {im(1)}) }}</DisplayString>
        <DisplayString>{{ size={size()} }}</DisplayString>
        <Expand>
            <Synthetic Name="[real]">
                <DisplayString>{{ size={(int)(sizeof(m_data.re) / sizeof($T1))} }}</DisplayString>
                <Expand>
                    <ArrayItems>
                        <Size>(int)(sizeof(m_data.re) / sizeof($T1))</Size>
                        <ValuePointer>($T1*)&amp;m_data.re</ValuePointer>
                    </ArrayItems>
                </Expand>
            </Synthetic>
            <Synthetic Name="[imag]">
                <DisplayString>{{ size={(int)(sizeof(m_data.im) / sizeof($T1))} }}</DisplayString>
                <Expand>
                    <ArrayItems>
                        <Size>(int)(sizeof(m_data.im) / sizeof($T1))</Size>
                        <ValuePointer>($T1*)&amp;m_data.im</ValuePointer>
                    </ArrayItems>
                </Expand>
            </Synthetic>
        </Expand>
    </Type>

    <!-- A mask lane is $T1 bytes, all set or all clear. -->
    <Type Name="nx::simd::basic_mask&lt;*,*&gt;">
        <Intrinsic Name="size" Expression="(int)(sizeof(m_data) / $T1)"/>
        <Intrinsic Name="at" Expression="(int)(((signed char*)&amp;m_data)[i * $T1] != 0)">
            <Parameter Name="i" Type="int"/>
        </Intrinsic>
        <DisplayString Condition="size() == 1">{{ {at(0)} }}</DisplayString>
        <DisplayString Condition="size() == 2">{{ {at(0)}{at(1)} }}</DisplayString>
        <DisplayString Condition="size() == 3">{{ {at(0)}{at(1)}{at(2)} }}</DisplayString>
        <DisplayString Condition="size() == 4">{{ {at(0)}{at(1)}{at(2)}{at(3)} }}</DisplayString>
        <DisplayString Condition="size() == 8">{{ {at(0)}{at(1)}{at(2)}{at(3)}{at(4)}{at(5)}{at(6)}{at(7)} }}</DisplayString>
        <DisplayString>{{ size={size()} }}</DisplayString>
        <Expand>
            <IndexListItems>
                <Size>size()</Size>
                <ValueNode>((signed char*)&amp;m_data)[$i * $T1] != 0</ValueNode>
            </IndexListItems>
        </Expand>
    </Type>

    <Type Name="nx::simd::detail::simd_iterator&lt;*&gt;">
        <DisplayString Condition="m_data == nullptr">null</DisplayString>
        <DisplayString>{{ index={m_offset} }}</DisplayString>
        <Expand>
            <Item Name="[index]">m_offset</Item>
            <Item Name="[vector]" Condition="m_data != nullptr">*m_data</Item>
        </Expand>
    </Type>

</AutoVisualizer>
